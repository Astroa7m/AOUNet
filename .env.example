# Copy this file to .env and fill in what you need. Only GROQ_API_KEY1 is required.

# Required: free key from https://console.groq.com/keys (no credit card)
GROQ_API_KEY1=
# Optional: a second key for the summarization model, falls back to GROQ_API_KEY1
GROQ_API_KEY2=
# Optional: change these if Groq retires a model
LLM_MODEL=openai/gpt-oss-20b
FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
SUMMARY_MODEL=openai/gpt-oss-120b

# Optional: knowledge base. embedded (default) uses vector_store/ in the repo, server uses QDRANT_URL
VECTOR_STORE=embedded
QDRANT_URL=
QDRANT_API_KEY=

# Optional: log every query and answer to a Supabase table called query_logs
SUPABASE_URL=
SUPABASE_KEY=
# Optional: only for graph/sql_agent.py (experimental)
SUPABASE_CONNECTION_STRING=

# Email for the student and tutor tools.
# demo (default): emails stay inside the app, safe for a public demo
# gmail: real email through SMTP/IMAP. Use a Gmail app password, never your real password.
EMAIL_MODE=demo
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional: LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
